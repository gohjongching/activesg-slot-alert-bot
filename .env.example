# Telegram Bot Credentials
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID or Channel ID (obtain from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Target sport/activity (e.g. badminton, tennis, squash, table tennis, gym)
ACTIVITY=badminton

# Monitored Venues (comma-separated list, case-insensitive substring matching)
# E.g. Clementi, Jurong East, Bishan, Delta, Heartbeat@Bedok, Pasir Ris, Tampines Hub
MONITORED_VENUES=Clementi,Jurong East,Bishan,Delta,Heartbeat@Bedok

# Days of the week to notify (comma-separated: Mon,Tue,Wed,Thu,Fri,Sat,Sun)
# Leave empty to monitor ALL days
TARGET_DAYS=Mon,Tue,Wed,Thu,Fri,Sat,Sun

# Specific hours to monitor (e.g. 18:00,19:00,20:00,21:00)
# Leave empty to monitor ALL hours
TARGET_HOURS=18:00,19:00,20:00,21:00

# How often to check for slots (in seconds)
# Recommended: 60 - 120s to avoid aggressive rate-limiting
CHECK_INTERVAL_SECONDS=90

# Headless mode for Playwright (true for background/GCP, false for visual debugging)
HEADLESS=true
